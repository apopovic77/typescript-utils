{
  "name": "@arkturian/typescript-utils",
  "version": "1.4.1",
  "description": "TypeScript utilities including InterpolatedProperty, Vector math, Quaternions, and Easing functions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "tsc --noEmit && esbuild test/layout.test.ts --bundle --platform=node --format=esm --outfile=test/.out/layout.mjs --log-level=error && node test/.out/layout.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apopovic77/typescript-utils.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "typescript",
    "animation",
    "properties",
    "interpolation",
    "vector",
    "easing",
    "field-aware",
    "self-organizing",
    "3d-engine"
  ],
  "author": "Alex Popovic <alex@arkturian.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/apopovic77/typescript-utils/issues"
  },
  "homepage": "https://github.com/apopovic77/typescript-utils#readme",
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/three": "^0.180.0",
    "esbuild": "^0.21.5",
    "three": "^0.180.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@arkturian/typescript-utils": "^1.3.1"
  }
}
